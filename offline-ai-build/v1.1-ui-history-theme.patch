+    private fun showThemeDialog() {
+        val options = arrayOf("Koyu tema", "Açık tema")
+        val selected = if (isDarkTheme) 0 else 1
+        AlertDialog.Builder(this)
+            .setTitle("Tema")
+            .setSingleChoiceItems(options, selected) { dialog, which ->
+                val dark = which == 0
+                if (dark != isDarkTheme) {
+                    persistCurrentChat()
+                    prefs().edit().putBoolean(KEY_DARK_THEME, dark).apply()
+                    dialog.dismiss()
+                    recreate()
+                } else {
+                    dialog.dismiss()
+                }
+            }
+            .setNegativeButton("Vazgeç", null)
+            .show()
+    }
+
+    private fun recordChatLine(role: String, text: String) {
+        if (text.isBlank()) return
+        currentChatLines += ChatLine(role, text)
+        persistCurrentChat()
+    }
+
+    private fun persistCurrentChat() {
+        if (currentChatLines.isEmpty()) return
+        val existing = loadChatHistory().filterNot { it.id == currentChatId }
+        val titleSource = currentChatLines.firstOrNull { it.role == "user" }?.text ?: "Sohbet"
+        val title = titleSource.replace("\n", " ").trim().let { if (it.length > 42) it.take(42) + "…" else it }
+        val current = StoredChat(currentChatId, title.ifBlank { "Sohbet" }, System.currentTimeMillis(), currentChatLines.toList())
+        val merged = (listOf(current) + existing).take(30)
+        val array = JSONArray()
+        merged.forEach { chat ->
+            val messages = JSONArray()
+            chat.messages.forEach { line -> messages.put(JSONObject().put("role", line.role).put("text", line.text)) }
+            array.put(JSONObject().put("id", chat.id).put("title", chat.title).put("updatedAt", chat.updatedAt).put("messages", messages))
+        }
+        prefs().edit().putString(KEY_CHAT_HISTORY, array.toString()).apply()
+    }
+
+    private fun loadChatHistory(): List<StoredChat> {
+        val raw = prefs().getString(KEY_CHAT_HISTORY, null) ?: return emptyList()
+        return runCatching {
+            val array = JSONArray(raw)
+            buildList {
+                for (i in 0 until array.length()) {
+                    val obj = array.optJSONObject(i) ?: continue
+                    val messageArray = obj.optJSONArray("messages") ?: JSONArray()
+                    val messages = buildList {
+                        for (j in 0 until messageArray.length()) {
+                            val line = messageArray.optJSONObject(j) ?: continue
+                            val role = line.optString("role")
+                            val text = line.optString("text")
+                            if (text.isNotBlank()) add(ChatLine(role, text))
+                        }
+                    }
+                    add(StoredChat(obj.optLong("id"), obj.optString("title", "Sohbet"), obj.optLong("updatedAt"), messages))
+                }
+            }.sortedByDescending { it.updatedAt }
+        }.getOrDefault(emptyList())
+    }
+
+    private fun showChatHistory() {
+        persistCurrentChat()
+        val chats = loadChatHistory()
+        if (chats.isEmpty()) {
+            Toast.makeText(this, "Henüz kayıtlı sohbet yok.", Toast.LENGTH_SHORT).show()
+            return
+        }
+        val scroll = ScrollView(this).apply { setBackgroundColor(dialogBg) }
+        val body = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; setPadding(dp(18), dp(16), dp(18), dp(20)) }
+        scroll.addView(body, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        body.addView(TextView(this).apply { text = "Sohbet geçmişi"; setTextColor(dialogText); textSize = 24f; typeface = Typeface.DEFAULT_BOLD })
+        val formatter = SimpleDateFormat("dd.MM.yyyy  HH:mm", Locale("tr", "TR"))
+        chats.forEach { chat ->
+            val item = LinearLayout(this).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(dp(15), dp(13), dp(15), dp(13))
+                background = rounded(dialogCard, 18f)
+                setOnClickListener { showStoredChat(chat) }
+            }
+            item.addView(TextView(this).apply { text = chat.title; setTextColor(dialogText); textSize = 16f; typeface = Typeface.DEFAULT_BOLD })
+            item.addView(TextView(this).apply { text = formatter.format(Date(chat.updatedAt)); setTextColor(dialogMuted); textSize = 12f; setPadding(0, dp(5), 0, 0) })
+            body.addView(item, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply { topMargin = dp(10) })
+        }
+        val dialog = AlertDialog.Builder(this).setView(scroll).setNegativeButton("Kapat", null).create()
+        dialog.setOnShowListener { dialog.window?.setBackgroundDrawable(rounded(dialogBg, 18f)); dialog.window?.setLayout((resources.displayMetrics.widthPixels * 0.94f).toInt(), (resources.displayMetrics.heightPixels * 0.84f).toInt()) }
+        dialog.show()
+    }
+
+    private fun showStoredChat(chat: StoredChat) {
+        val scroll = ScrollView(this).apply { setBackgroundColor(dialogBg) }
+        val body = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; setPadding(dp(18), dp(16), dp(18), dp(22)) }
+        scroll.addView(body, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        body.addView(TextView(this).apply { text = chat.title; setTextColor(dialogText); textSize = 22f; typeface = Typeface.DEFAULT_BOLD })
+        chat.messages.forEach { line ->
+            val message = TextView(this).apply {
+                text = line.text
+                textSize = if (line.role == "assistant") 17f else 15f
+                setTextColor(if (line.role == "assistant") assistantText else primaryText)
+                typeface = if (line.role == "assistant") Typeface.create("serif", Typeface.NORMAL) else Typeface.DEFAULT_BOLD
+                setLineSpacing(dp(3).toFloat(), 1.12f)
+                setPadding(dp(14), dp(10), dp(14), dp(10))
+                background = if (line.role == "assistant") null else rounded(panel2, 18f)
+                setTextIsSelectable(true)
+            }
+            body.addView(message, LinearLayout.LayoutParams(if (line.role == "assistant") ViewGroup.LayoutParams.MATCH_PARENT else ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+                gravity = if (line.role == "assistant") Gravity.START else Gravity.END
+                topMargin = dp(12)
+            })
+        }
+        val dialog = AlertDialog.Builder(this).setView(scroll).setNegativeButton("Kapat", null).create()
+        dialog.setOnShowListener { dialog.window?.setBackgroundDrawable(rounded(dialogBg, 18f)); dialog.window?.setLayout((resources.displayMetrics.widthPixels * 0.96f).toInt(), (resources.displayMetrics.heightPixels * 0.88f).toInt()) }
+        dialog.show()
+    }
