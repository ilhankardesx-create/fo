+    private fun scrollToBottom(force: Boolean = true) {
+        if (!::conversationScroll.isInitialized || conversationScroll.visibility != View.VISIBLE) return
+        if (!force && !isNearConversationBottom()) return
+        if (autoScrollPosted) return
+
+        val now = SystemClock.uptimeMillis()
+        val minInterval = if (force) 0L else 72L
+        val wait = (minInterval - (now - lastAutoScrollAt)).coerceAtLeast(0L)
+        autoScrollPosted = true
+        conversationScroll.postDelayed({
+            autoScrollPosted = false
+            if (!force && !isNearConversationBottom()) return@postDelayed
+            val child = conversationScroll.getChildAt(0) ?: return@postDelayed
+            val maxY = (child.height - conversationScroll.height + conversationScroll.paddingBottom).coerceAtLeast(0)
+            conversationScroll.scrollTo(0, maxY)
+            lastAutoScrollAt = SystemClock.uptimeMillis()
+        }, wait)
+    }
+
+    private fun isNearConversationBottom(): Boolean {
+        if (!::conversationScroll.isInitialized) return true
+        val child = conversationScroll.getChildAt(0) ?: return true
+        val maxY = (child.height - conversationScroll.height + conversationScroll.paddingBottom).coerceAtLeast(0)
+        return maxY - conversationScroll.scrollY <= dp(280)
+    }
 
